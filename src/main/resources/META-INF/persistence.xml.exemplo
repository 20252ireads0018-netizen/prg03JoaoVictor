<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copie este arquivo para persistence.xml (mesma pasta), preencha a URL, o usuario
  e a senha reais. O persistence.xml esta no .gitignore e NAO deve ser versionado.

  O schema NAO e mais gerado pelo Hibernate: quem cria e evolui as tabelas sao as
  migrations do Flyway (src/main/resources/db/migration), aplicadas no inicio da
  aplicacao. Por isso hbm2ddl.auto fica em "validate": o Hibernate apenas confere
  se as entidades batem com o banco.
-->
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="pgcdPU" transaction-type="RESOURCE_LOCAL">
        <class>br.com.ifba.produto.entity.Produto</class>
        <class>br.com.ifba.produto.entity.Categoria</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/SEU_BANCO?createDatabaseIfNotExist=true&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="SEU_USUARIO"/>
            <property name="jakarta.persistence.jdbc.password" value="SUA_SENHA"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
